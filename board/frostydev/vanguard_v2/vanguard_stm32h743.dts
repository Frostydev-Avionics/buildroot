/dts-v1/;
/*
 * Device Tree Source for the Vanguard V2 Flight Controller.
 * Customized for bare-metal XIP execution on the STM32H743VIT.
 * Pin mappings derived from Vanguard V2 board.h
 */
#include "stm32h743.dtsi"
#include "stm32h7-pinctrl.dtsi"
#include <dt-bindings/pinctrl/stm32-pinfunc.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "FrostyDev Vanguard V2";
	compatible = "frostydev,vanguard-v2", "st,stm32h743";

	chosen {
		/* Boot directly from internal initramfs with early debug output */
		bootargs = "root=/dev/ram init=/init console=ttyGS0,115200 ignore_loglevel";
		stdout-path = "serial0:115200n8";
	};

	/* 512KB Internal AXI SRAM mapped for Linux main memory */
	memory@24000000 {
		device_type = "memory";
		reg = <0x24000000 0x80000>;
	};

	aliases {
		serial0 = &usart1;
	};

	/* Vanguard V2 Diagnostics LEDs */
	leds {
		compatible = "gpio-leds";

		led-red {
			label = "vanguard:red";
			gpios = <&gpiog 2 GPIO_ACTIVE_HIGH>; /* PG2 */
			default-state = "off";
		};

		led-green {
			label = "vanguard:green";
			gpios = <&gpiog 3 GPIO_ACTIVE_HIGH>; /* PG3 */
			default-state = "off";
		};

		led-blue {
			label = "vanguard:blue";
			gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>; /* PB2 */
			default-state = "off";
		};
	};
};

/* --- CLOCK OVERRIDES --- */
&clk_hse {
	/* MCO: 25 MHz HSE derived from board.h */
	clock-frequency = <25000000>;
};

/* --- PINCTRL MULTIPLEXING DEFINITIONS --- */
&pinctrl {

	usart1_pins: usart1-0 {
		pins1 {
			pinmux = <STM32_PINMUX('B', 14, AF4)>; /* USART1_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('B', 15, AF4)>; /* USART1_RX */
			bias-disable;
		};
	};

	i2c1_pins: i2c1-0 {
		pins {
			pinmux = <STM32_PINMUX('B', 6, AF4)>,  /* I2C1_SCL */
			         <STM32_PINMUX('B', 7, AF4)>;  /* I2C1_SDA */
			bias-disable;
			drive-open-drain;
			slew-rate = <0>;
		};
	};

	spi1_pins: spi1-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 5, AF5)>,  /* SPI1_SCK */
			         <STM32_PINMUX('B', 5, AF5)>;  /* SPI1_MOSI */
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('A', 6, AF5)>;  /* SPI1_MISO */
			bias-disable;
		};
	};

	usbotg_fs_pins: usbotg_fs-0 {
		pins {
			pinmux = <STM32_PINMUX('A', 10, AF10)>, /* OTG_FS_ID */
			         <STM32_PINMUX('A', 11, AF10)>, /* OTG_FS_DM */
			         <STM32_PINMUX('A', 12, AF10)>; /* OTG_FS_DP */
			bias-disable;
			drive-push-pull;
			slew-rate = <2>;
		};
	};
};

/* --- PERIPHERAL ACTIVATION --- */

&usart1 {
	pinctrl-0 = <&usart1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;
	status = "okay";
};

&spi1 {
	pinctrl-0 = <&spi1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usbotg_fs {
	pinctrl-0 = <&usbotg_fs_pins>;
	pinctrl-names = "default";
	dr_mode = "otg";
	status = "okay";
};