CONFIG_ARM=y
CONFIG_ARCH_STM32=y
CONFIG_TEXT_BASE=0x08000000
CONFIG_SYS_MALLOC_LEN=0x100000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x24040000
CONFIG_ENV_SIZE=0x2000
CONFIG_DEFAULT_DEVICE_TREE="vanguard_stm32h743"
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_SYS_LOAD_ADDR=0xD0008000
CONFIG_STM32H7=y
CONFIG_TARGET_STM32H743_EVAL=y

# --- VANGUARD RAW FLASH BOOT SETTINGS ---
CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTCOMMAND=y
# bootz <zImage_address> - <DTB_address>
CONFIG_BOOTCOMMAND="bootz 0x08060000 - 0x08040000"

CONFIG_AUTOBOOT_KEYED=y
CONFIG_AUTOBOOT_PROMPT="Hit SPACE in %d seconds to stop autoboot.\n"
CONFIG_AUTOBOOT_STOP_STR=" "
CONFIG_SYS_CBSIZE=256
CONFIG_SYS_PBSIZE=282
CONFIG_SYS_PROMPT="U-Boot > "
CONFIG_CMD_CACHE=y
CONFIG_CMD_TIMER=y
CONFIG_OF_CONTROL=y
CONFIG_ENV_RELOC_GD_ENV_ADDR=y
CONFIG_NO_NET=y
CONFIG_LED=y
CONFIG_LED_BOOT=y
CONFIG_LED_GPIO=y

CONFIG_CMD_MMC=y
CONFIG_MMC=y
CONFIG_STM32_SDMMC2=y

# --- ENVIRONMENT FIXES ---
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set

# --- DISABLED FEATURES ---
# CONFIG_DISTRO_DEFAULTS is not set
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_BOARD_INIT is not set
# CONFIG_PINCTRL_FULL is not set
# CONFIG_CMD_GPT is not set
# CONFIG_OF_UPSTREAM is not set