# --- Vanguard V2 Unified Config ---

# Architecture & CPU
CONFIG_ARM=y
CONFIG_ARM_V7M=y
CONFIG_CPU_V7M=y
CONFIG_ARM_THUMB=y
CONFIG_ARM_THUMB2=y
CONFIG_ARCH_V7M=y
CONFIG_NO_IOPORT_MAP=y
CONFIG_CPU_V7=n

# Boot & XIP
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x08000400
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=n
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="root=/dev/ram console=ttyGS0,115200"

# Peripheral Drivers
CONFIG_SERIAL_STM32=y
CONFIG_PINCTRL_STM32=y
CONFIG_I2C_STM32F7=y
CONFIG_SPI_STM32=y

# USB Gadget (Virtual Console)
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CONSOLE=y
CONFIG_USB_G_SERIAL=y

# Memory Management (Critical for No-MMU)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_FLAT=y
CONFIG_MMU=n

# Disable unneeded features to save flash
CONFIG_INPUT=n
CONFIG_VT=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n